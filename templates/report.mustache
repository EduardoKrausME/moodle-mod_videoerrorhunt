{{! @template mod_videoerrorhunt/report }}
<div class="videoerrorhunt-report">
    <div class="d-flex justify-content-between align-items-center mb-3"><h2>{{#str}}
        report, videoerrorhunt{{/str}} — {{{activityname}}}</h2><a class="btn btn-secondary"
                                                                   href="{{{backurl}}}">{{#str}}
        backtoactivity, videoerrorhunt{{/str}}</a></div>
    {{#hasrows}}
        <div class="table-responsive">
            <table class="table table-striped">
                <thead>
                <tr>
                    <th>{{#str}}student, videoerrorhunt{{/str}}</th>
                    <th>{{#str}}watched, videoerrorhunt{{/str}}</th>
                    <th>{{#str}}found, videoerrorhunt{{/str}}</th>
                    <th>{{#str}}missed, videoerrorhunt{{/str}}</th>
                    <th>{{#str}}incorrectmarks, videoerrorhunt{{/str}}</th>
                    <th>{{#str}}score, videoerrorhunt{{/str}}</th>
                    <th>{{#str}}grade, videoerrorhunt{{/str}}</th>
                    <th>{{#str}}status, videoerrorhunt{{/str}}</th>
                </tr>
                </thead>
                <tbody>{{#rows}}
                    <tr>
                        <td><a href="{{{detailurl}}}">{{name}}</a></td>
                        <td>{{percent}}%</td>
                        <td>{{found}}</td>
                        <td>{{missed}}</td>
                        <td>{{incorrect}}</td>
                        <td>{{score}}</td>
                        <td>{{grade}}</td>
                        <td>{{status}}</td>
                    </tr>{{/rows}}</tbody>
            </table>
        </div>
    {{/hasrows}}
    {{^hasrows}}
        <div class="alert alert-info">{{#str}}noreportdata, videoerrorhunt{{/str}}</div>{{/hasrows}}

    {{#hashardest}}<h3>{{#str}}hardesterrors, videoerrorhunt{{/str}}</h3>
        <div class="table-responsive">
            <table class="table table-sm">
                <thead>
                <tr>
                    <th>{{#str}}errortitle, videoerrorhunt{{/str}}</th>
                    <th>{{#str}}timerange, videoerrorhunt{{/str}}</th>
                    <th>{{#str}}studentsfound, videoerrorhunt{{/str}}</th>
                    <th>{{#str}}findrate, videoerrorhunt{{/str}}</th>
                    <th>{{#str}}difficulty, videoerrorhunt{{/str}}</th>
                </tr>
                </thead>
                <tbody>{{#hardest}}
                    <tr>
                        <td>{{title}}</td>
                        <td>{{range}}</td>
                        <td>{{found}}</td>
                        <td>{{rate}}%</td>
                        <td>{{difficulty}}%</td>
                    </tr>{{/hardest}}</tbody>
            </table>
        </div>{{/hashardest}}

    {{#detailuser}}<h3>{{#str}}studentdetail, videoerrorhunt{{/str}} — {{detailuser}}</h3>{{/detailuser}}
    {{#hasdetail}}
        <div class="table-responsive">
            <table class="table table-sm">
                <thead>
                <tr>
                    <th>{{#str}}time, videoerrorhunt{{/str}}</th>
                    <th>{{#str}}explanation, videoerrorhunt{{/str}}</th>
                    <th>{{#str}}result, videoerrorhunt{{/str}}</th>
                    <th>{{#str}}matchedto, videoerrorhunt{{/str}}</th>
                    <th>{{#str}}points, videoerrorhunt{{/str}}</th>
                </tr>
                </thead>
                <tbody>{{#detail}}
                    <tr>
                        <td>{{timecode}}</td>
                        <td>{{explanation}}</td>
                        <td>{{result}}</td>
                        <td>{{error}}</td>
                        <td>{{points}}</td>
                    </tr>{{/detail}}</tbody>
            </table>
        </div>{{/hasdetail}}

    {{#detailuser}}{{#hasmissederrors}}
        <h4>{{#str}}missederrorslist, videoerrorhunt{{/str}}</h4>
        <div class="table-responsive">
            <table class="table table-sm">
                <thead>
                <tr>
                    <th>{{#str}}errortitle, videoerrorhunt{{/str}}</th>
                    <th>{{#str}}timerange, videoerrorhunt{{/str}}</th>
                    <th>{{#str}}errorpoints, videoerrorhunt{{/str}}</th>
                </tr>
                </thead>
                <tbody>{{#missederrors}}
                    <tr>
                        <td>{{title}}</td>
                        <td>{{range}}</td>
                        <td>{{points}}</td>
                    </tr>{{/missederrors}}</tbody>
            </table>
        </div>
    {{/hasmissederrors}}{{/detailuser}}
</div>
